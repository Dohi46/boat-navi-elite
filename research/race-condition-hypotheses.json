{
  "schema": "boat-nexus-hypotheses-v1",
  "status": "research-only-not-deployed",
  "principles": [
    "Sources supply hypotheses, not universal prediction rules",
    "Never train on post-race data for pre-race forecasts",
    "Check venue-specific direction, wind speed, tide, season and field strength",
    "Compare out-of-sample baseline before deploying",
    "No new API calls or duplicated race snapshots"
  ],
  "hypotheses": [
