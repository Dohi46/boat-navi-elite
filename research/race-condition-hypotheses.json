      "claim": "向かい風はまくりが効きやすい場合がある",
      "sources": [
        "https://www.boatrace.jp/owsp/sp/extra/enjoy/guide/level2/l2_01_05_01.html"
      ],
      "requiredFeatures": [
        "wind_direction_number",
        "wind_speed",
        "venue",
        "raceDate",
        "entry_course"
      ],
      "validation": "Compare 1st-place course and winning method by venue, direction and wind-speed bins",
      "status": "unverified-for-boat-nexus"
    },
    {
      "id": "wind_tail_sashi",
